---
import '../styles/global.css';
import { SITE, NAV } from '../site.config';
import { CATEGORIES } from '../data/categories';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  jsonLd?: object | object[];
}
const { title, description, type = 'website', noindex = false, image, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {ld.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}

    {
      SITE.adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      SITE.gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          <script is:inline define:vars={{ gaId: SITE.gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          {SITE.name}
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h2>Categories</h2>
            <ul>
              {
                CATEGORIES.map((c) => (
                  <li>
                    <a href={`/category/${c.slug}/`}>{c.name}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              <li><a href="/tools/">All AI tools</a></li>
              <li><a href="/compare/">Comparisons</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div>
            <h2>{SITE.name}</h2>
            <ul>
              <li><a href="/about/">About &amp; how we review</a></li>
              <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
              <li><a href="/privacy/">Privacy policy</a></li>
            </ul>
          </div>
        </div>
        <p>
          Some links on this site are affiliate links. If you buy through them we may earn a commission at no extra cost
          to you. Product names and trademarks belong to their respective owners.
        </p>
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
