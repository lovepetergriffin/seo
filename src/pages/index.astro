---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../site.config';
import { CATEGORIES } from '../data/categories';
import { getTools, getPosts, getComparisons, formatDate } from '../lib/content';

const tools = await getTools();
const featured = tools.filter((t) => t.data.featured).slice(0, 9);
const posts = (await getPosts()).slice(0, 3);
const comparisons = await getComparisons();
const count = (slug: string) => tools.filter((t) => t.data.category === slug).length;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: Astro.site?.href,
    description: SITE.description,
  },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
];
---

<Base title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <h1>{SITE.tagline}</h1>
    <p class="lead">
      {tools.length} AI tools reviewed in plain language: what each one does, what it costs, where it falls short and
      what to use instead.
    </p>
    <form class="search" action="/tools/" method="get" role="search">
      <label class="sr-only" for="q">Search AI tools</label>
      <input id="q" name="q" type="search" placeholder="Search tools, e.g. video, coding, notes" />
      <button class="btn" type="submit">Search</button>
    </form>
  </section>

  <div class="section-head">
    <h2>Browse by category</h2>
  </div>
  <div class="cat-grid">
    {
      CATEGORIES.map((c) => (
        <a class="cat" href={`/category/${c.slug}/`}>
          <strong>{c.name}</strong>
          <span>
            {count(c.slug)} tool{count(c.slug) === 1 ? '' : 's'}
          </span>
        </a>
      ))
    }
  </div>

  <div class="section-head">
    <h2>Featured AI tools</h2>
    <a href="/tools/">View all {tools.length} →</a>
  </div>
  <div class="grid">
    {featured.map((tool) => <ToolCard tool={tool} />)}
  </div>

  <AdSlot />

  <div class="section-head">
    <h2>Popular comparisons</h2>
    <a href="/compare/">All comparisons →</a>
  </div>
  <div class="cat-grid">
    {
      comparisons.map(({ entry, a, b }) => (
        <a class="cat" href={`/compare/${entry.id}/`}>
          <strong>
            {a.data.name} vs {b.data.name}
          </strong>
          <span>{entry.data.description}</span>
        </a>
      ))
    }
  </div>

  <div class="section-head">
    <h2>From the blog</h2>
    <a href="/blog/">All articles →</a>
  </div>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <h3>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p class="muted small">{formatDate(post.data.pubDate)}</p>
          <p class="muted">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
