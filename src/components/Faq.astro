---
import { faqLd } from '../lib/content';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section>
      <h2>Frequently asked questions</h2>
      {items.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd(items))} />
    </section>
  )
}
